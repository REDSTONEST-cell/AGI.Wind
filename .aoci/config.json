{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    ".next",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_root_dirs": [
    "backup",
    "backups",
    "build",
    "cache",
    "coverage",
    "dist",
    "target",
    "tmp",
    "uploads",
    "artifacts",
    "vendor"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 7000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "production",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "starter-vendored-static-libs",
        "action": "observe",
        "pattern": "**/static/**/libs/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 100,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-lib",
        "action": "observe",
        "pattern": "**/static/**/lib/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 101,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-static-plugins",
        "action": "observe",
        "pattern": "**/static/**/plugins/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 102,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-js",
        "action": "observe",
        "pattern": "**/*.min.js",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 103,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-min-css",
        "action": "observe",
        "pattern": "**/*.min.css",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 104,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-source-map",
        "action": "observe",
        "pattern": "**/*.map",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 105,
        "enabled": true
      },
      {
        "rule_id": "starter-vendored-fonts",
        "action": "observe",
        "pattern": "**/fonts/**",
        "pattern_kind": "glob",
        "reason": "vendored static assets and generated bundles are observed, not indexed; delete this rule before the first scan if the path holds your own code",
        "source": "builtin",
        "created_by": "aoci-init",
        "order": 106,
        "enabled": true
      },
      {
        "rule_id": "project-runtime-devtools",
        "action": "exclude",
        "pattern": ".devtools",
        "pattern_kind": "directory",
        "reason": "项目隔离运行环境、第三方依赖、临时验证和历史快照；生产源码在app/scripts/packages/config/docs",
        "source": "user",
        "created_by": "codex",
        "order": 1000,
        "enabled": true
      },
      {
        "rule_id": "project-build-output",
        "action": "exclude",
        "pattern": "output",
        "pattern_kind": "directory",
        "reason": "Generated packages and asset previews",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-external-tools",
        "action": "exclude",
        "pattern": "tools",
        "pattern_kind": "directory",
        "reason": "External tools and original research assets; adapters remain in app and scripts",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-model-cache",
        "action": "exclude",
        "pattern": "fastembed_cache",
        "pattern_kind": "directory",
        "reason": "Downloaded rebuildable model cache",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-node-modules",
        "action": "exclude",
        "pattern": "**/node_modules/**",
        "pattern_kind": "glob",
        "reason": "Rebuildable third party JavaScript dependencies",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-pip-work",
        "action": "exclude",
        "pattern": "pip-*/**",
        "pattern_kind": "glob",
        "reason": "Generated pip build and unpack caches",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-pytest-work",
        "action": "exclude",
        "pattern": "pytest-of-wind",
        "pattern_kind": "directory",
        "reason": "Generated isolated test data",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-research",
        "action": "exclude",
        "pattern": "research",
        "pattern_kind": "directory",
        "reason": "Downloaded third party references",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-runtime-data",
        "action": "exclude",
        "pattern": "data",
        "pattern_kind": "directory",
        "reason": "Private runtime databases tokens media logs and verification output",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-temporary",
        "action": "exclude",
        "pattern": ".tmp",
        "pattern_kind": "directory",
        "reason": "调试脚本、临时语音转换及第三方安装输入，不是交付源码",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-venvs",
        "action": "exclude",
        "pattern": "**/.venv/**",
        "pattern_kind": "glob",
        "reason": "Third party Python virtual environments",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      },
      {
        "rule_id": "project-worker-ledgers",
        "action": "exclude",
        "pattern": ".superpowers",
        "pattern_kind": "directory",
        "reason": "Task runtime ledgers; formal design and acceptance remain in docs",
        "source": "user",
        "created_by": "codex",
        "order": 1001,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [
    "codex"
  ],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
