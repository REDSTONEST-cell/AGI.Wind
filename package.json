{
  "name": "agi-wind-workspace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {"node": "24.21.0"},
  "scripts": {
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:types": "json2ts -i packages/contracts/schema.json -o packages/contracts/types.ts --no-additionalProperties --unreachableDefinitions",
    "contracts:check": "node scripts/check-contracts.mjs",
    "test": "node --test packages/client-sdk/tests/*.test.mjs"
  },
  "devDependencies": {"json-schema-to-typescript": "15.0.4", "typescript": "5.9.3"}
}
