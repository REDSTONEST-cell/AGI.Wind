{
  "$defs": {
    "AcceptedRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "events_url": {
          "title": "Events Url",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "generation_id",
        "epoch",
        "events_url"
      ],
      "title": "AcceptedRequest",
      "type": "object"
    },
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "user_id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AudioSegment": {
      "additionalProperties": false,
      "properties": {
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "segment_index": {
          "minimum": 0,
          "title": "Segment Index",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "voice_id": {
          "title": "Voice Id",
          "type": "string"
        },
        "voice_version": {
          "title": "Voice Version",
          "type": "string"
        },
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "sample_rate": {
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "channels": {
          "maximum": 8,
          "minimum": 1,
          "title": "Channels",
          "type": "integer"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "generation_id",
        "epoch",
        "segment_id",
        "segment_index",
        "text",
        "voice_id",
        "voice_version",
        "asset_id",
        "sample_rate",
        "channels",
        "duration_ms"
      ],
      "title": "AudioSegment",
      "type": "object"
    },
    "AvatarCue": {
      "additionalProperties": false,
      "properties": {
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "segment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Id"
        },
        "expression": {
          "default": "neutral",
          "title": "Expression",
          "type": "string"
        },
        "motion": {
          "default": "idle",
          "title": "Motion",
          "type": "string"
        },
        "intensity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "duration_ms": {
          "default": 1000,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "sync": {
          "default": "immediate",
          "enum": [
            "immediate",
            "segment_start",
            "segment_end"
          ],
          "title": "Sync",
          "type": "string"
        }
      },
      "required": [
        "generation_id",
        "epoch"
      ],
      "title": "AvatarCue",
      "type": "object"
    },
    "ChatInput": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": "",
          "maxLength": 48000,
          "title": "Text",
          "type": "string"
        },
        "asset_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Asset Ids",
          "type": "array"
        }
      },
      "title": "ChatInput",
      "type": "object"
    },
    "ChatRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/ChatInput"
        },
        "output": {
          "$ref": "#/$defs/OutputOptions"
        },
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "conversation_id",
        "input",
        "device_id"
      ],
      "title": "ChatRequest",
      "type": "object"
    },
    "ContentPart": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "text",
            "image",
            "audio"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        }
      },
      "required": [
        "type"
      ],
      "title": "ContentPart",
      "type": "object"
    },
    "ContextBundle": {
      "additionalProperties": false,
      "properties": {
        "memory_revision": {
          "title": "Memory Revision",
          "type": "integer"
        },
        "persona_snapshot": {
          "$ref": "#/$defs/PersonaSnapshot"
        },
        "recent_events": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Recent Events",
          "type": "array"
        },
        "memories": {
          "items": {
            "$ref": "#/$defs/MemoryHit"
          },
          "title": "Memories",
          "type": "array"
        },
        "current_input": {
          "$ref": "#/$defs/ChatInput"
        },
        "vision_observations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Vision Observations",
          "type": "array"
        },
        "token_estimate": {
          "title": "Token Estimate",
          "type": "integer"
        },
        "selected_source_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Selected Source Ids",
          "type": "array"
        }
      },
      "required": [
        "memory_revision",
        "persona_snapshot",
        "recent_events",
        "memories",
        "current_input",
        "vision_observations",
        "token_estimate",
        "selected_source_ids"
      ],
      "title": "ContextBundle",
      "type": "object"
    },
    "MemoryHit": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Id"
        },
        "chunk_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "epistemic_type": {
          "enum": [
            "user_asserted",
            "observed",
            "assistant_generated",
            "inferred",
            "fictional"
          ],
          "title": "Epistemic Type",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "time_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "format": "date-time",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Range"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "historical"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "content",
        "score",
        "epistemic_type",
        "source_refs"
      ],
      "title": "MemoryHit",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "config_version": {
          "default": 1,
          "minimum": 1,
          "title": "Config Version",
          "type": "integer"
        }
      },
      "required": [
        "provider_id",
        "model_id"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "OutputOptions": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": true,
          "title": "Text",
          "type": "boolean"
        },
        "audio": {
          "default": false,
          "title": "Audio",
          "type": "boolean"
        },
        "avatar": {
          "default": false,
          "title": "Avatar",
          "type": "boolean"
        },
        "voice": {
          "default": "auto",
          "enum": [
            "auto",
            "always",
            "off"
          ],
          "title": "Voice",
          "type": "string"
        },
        "realtime": {
          "default": false,
          "title": "Realtime",
          "type": "boolean"
        }
      },
      "title": "OutputOptions",
      "type": "object"
    },
    "PersonaSnapshot": {
      "additionalProperties": false,
      "properties": {
        "companion_id": {
          "format": "uuid",
          "title": "Companion Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "core": {
          "additionalProperties": true,
          "title": "Core",
          "type": "object"
        },
        "style": {
          "additionalProperties": true,
          "title": "Style",
          "type": "object"
        },
        "relationship": {
          "additionalProperties": true,
          "title": "Relationship",
          "type": "object"
        },
        "commitments": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Commitments",
          "type": "array"
        }
      },
      "required": [
        "companion_id",
        "version",
        "core",
        "style",
        "relationship",
        "commitments"
      ],
      "title": "PersonaSnapshot",
      "type": "object"
    },
    "RuntimeCapabilities": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": false,
          "title": "Text",
          "type": "boolean"
        },
        "image": {
          "default": false,
          "title": "Image",
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "title": "Streaming",
          "type": "boolean"
        },
        "cancel": {
          "default": false,
          "title": "Cancel",
          "type": "boolean"
        },
        "model_switch": {
          "default": false,
          "title": "Model Switch",
          "type": "boolean"
        },
        "context_injection": {
          "default": false,
          "title": "Context Injection",
          "type": "boolean"
        },
        "controlled_tools": {
          "default": false,
          "title": "Controlled Tools",
          "type": "boolean"
        },
        "local_state": {
          "default": false,
          "title": "Local State",
          "type": "boolean"
        }
      },
      "title": "RuntimeCapabilities",
      "type": "object"
    },
    "RuntimeDelta": {
      "additionalProperties": false,
      "properties": {
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "epoch": {
          "title": "Epoch",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "text",
            "tool",
            "end",
            "error"
          ],
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "generation_id",
        "epoch",
        "kind",
        "payload"
      ],
      "title": "RuntimeDelta",
      "type": "object"
    },
    "RuntimeRequest": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "epoch": {
          "title": "Epoch",
          "type": "integer"
        },
        "memory_revision": {
          "title": "Memory Revision",
          "type": "integer"
        },
        "model_ref": {
          "$ref": "#/$defs/ModelRef"
        },
        "persona_snapshot": {
          "$ref": "#/$defs/PersonaSnapshot"
        },
        "recent_events": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Recent Events",
          "type": "array"
        },
        "memories": {
          "items": {
            "$ref": "#/$defs/MemoryHit"
          },
          "title": "Memories",
          "type": "array"
        },
        "current_input": {
          "$ref": "#/$defs/ChatInput"
        },
        "vision_observations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Vision Observations",
          "type": "array"
        }
      },
      "required": [
        "scope",
        "generation_id",
        "epoch",
        "memory_revision",
        "model_ref",
        "persona_snapshot",
        "recent_events",
        "memories",
        "current_input",
        "vision_observations"
      ],
      "title": "RuntimeRequest",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "companion_id": {
          "format": "uuid",
          "title": "Companion Id",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "user_id",
        "companion_id",
        "conversation_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "json_pointer": {
          "default": "/text",
          "title": "Json Pointer",
          "type": "string"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "quote_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Hash"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "StreamEvent": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Protocol Version",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "enum": [
            "accepted",
            "memory.context",
            "text.delta",
            "text.segment",
            "text.completed",
            "audio.segment",
            "speech.queued",
            "avatar.cue",
            "generation.completed",
            "generation.cancelled",
            "generation.failed",
            "warning",
            "reasoning.delta",
            "reasoning.completed",
            "tool.started",
            "tool.completed",
            "sticker.sent"
          ],
          "title": "Type",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "epoch": {
          "minimum": 1,
          "title": "Epoch",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "sequence",
        "type",
        "generation_id",
        "epoch"
      ],
      "title": "StreamEvent",
      "type": "object"
    }
  },
  "title": "AGI.Wind protocol 1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "Actor": {
      "$ref": "#/$defs/Actor"
    },
    "Scope": {
      "$ref": "#/$defs/Scope"
    },
    "ModelRef": {
      "$ref": "#/$defs/ModelRef"
    },
    "PersonaSnapshot": {
      "$ref": "#/$defs/PersonaSnapshot"
    },
    "ContentPart": {
      "$ref": "#/$defs/ContentPart"
    },
    "SourceRef": {
      "$ref": "#/$defs/SourceRef"
    },
    "ContextBundle": {
      "$ref": "#/$defs/ContextBundle"
    },
    "RuntimeRequest": {
      "$ref": "#/$defs/RuntimeRequest"
    },
    "RuntimeDelta": {
      "$ref": "#/$defs/RuntimeDelta"
    },
    "MemoryHit": {
      "$ref": "#/$defs/MemoryHit"
    },
    "ChatRequest": {
      "$ref": "#/$defs/ChatRequest"
    },
    "AcceptedRequest": {
      "$ref": "#/$defs/AcceptedRequest"
    },
    "RuntimeCapabilities": {
      "$ref": "#/$defs/RuntimeCapabilities"
    },
    "AudioSegment": {
      "$ref": "#/$defs/AudioSegment"
    },
    "AvatarCue": {
      "$ref": "#/$defs/AvatarCue"
    },
    "StreamEvent": {
      "$ref": "#/$defs/StreamEvent"
    }
  }
}
